# ==============================================================================
# Sportradar Tennis Analytics - Environment Configuration
# ==============================================================================

# Sportradar Tennis API Key (Get free trial key from https://developer.sportradar.com/)
SPORTRADAR_API_KEY=your_sportradar_api_key_here
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE_CODE=en

# Database Configuration Options
# Choose either direct DATABASE_URL or individual connection parameters:

# Option 1: Full Database URL (PostgreSQL or MySQL)
# PostgreSQL format: postgresql://username:password@localhost:5432/tennis_analytics
# MySQL format: mysql+pymysql://username:password@localhost:3306/tennis_analytics
# SQLite format (for instant local zero-server development): sqlite:///tennis_analytics.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_analytics

# Option 2: Individual Connection Parameters (if DATABASE_URL is not set)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tennis_analytics
DB_USER=postgres
DB_PASSWORD=your_password

# Application Settings
DATA_CACHE_TTL_SECONDS=3600
DEBUG_MODE=False
